# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (supports MONGODB_URI or MONGO_URI)
MONGODB_URI=mongodb://127.0.0.1:27017/online-quiz-system
# MONGO_URI=mongodb://127.0.0.1:27017/online-quiz-system

# Authentication / JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=24h
BCRYPT_SALT_ROUNDS=10

# CORS Configuration
CORS_ORIGIN=*

# Initial Administrator Seed Credentials
ADMIN_NAME="System Administrator"
ADMIN_EMAIL=admin@codsoft.quiz
ADMIN_PASSWORD=AdminSecurePassword123!
